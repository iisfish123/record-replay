VOLC_PRESET_SPEAKER=zh_female_cancan_uranus_bigtts

VOLC_ACCESS_KEY_ID=
VOLC_ACCESS_KEY_SECRET=
VOLC_OMNI_REQ_KEY=realman_avatar_picture_omni20_cvtob

# 供应商切换：volcano=火山（音色 138 元/个）；minimax=MiniMax（音色 9.9 元/个）
VOICE_PROVIDER=minimax
RENDER_PROVIDER=minimax

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VIDEO_MODEL=MiniMax-H3-Lite
MINIMAX_VIDEO_RESOLUTION=768P
MINIMAX_VIDEO_DURATION=6
