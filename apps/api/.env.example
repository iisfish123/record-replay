MINIMAX_VIDEO_RATIO=9:16
MINIMAX_VIDEO_PROMPT="The person is speaking naturally to the camera."

# MiniMax 参考音频单段上限 15 秒（约 4.5 字/秒），70 字会超出上限被上游拒绝
ANSWER_MAX_CHARS=60
